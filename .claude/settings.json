{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(uv *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(SETTLEWELL_MOCK=1 uv *)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Edit(.env*)",
      "Edit(**/.env*)",
      "Write(.env*)",
      "Write(**/.env*)"
    ]
  }
}
